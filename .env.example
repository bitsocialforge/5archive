# 5archive server config. Copy to .env (gitignored) on the VPS — see DEPLOY.md.

# The 5chan bitsocial-cli daemon's PKC RPC endpoint, including its auth token.
# SECRET — never commit this, never copy it off the VPS. The container uses
# host networking, so localhost here really is the VPS host.
PKC_RPC_URL=ws://localhost:9138/REPLACE_WITH_DAEMON_AUTH_TOKEN

# Public URL of the web UI (used for sitemap / canonical links).
SITE_URL=https://5archive.org

# Browser origin allowed to call the API (the Vercel web UI).
# Comma-separate to add more origins later (e.g. a 5chan in-app search build).
ALLOWED_ORIGINS=https://5archive.org

# Re-crawl cadence (ms) and pagination depth per pass.
CRAWL_INTERVAL_MS=300000
CRAWL_MAX_PAGES=20
