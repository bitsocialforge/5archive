# 5archive server config. Copy to .env (gitignored) on the VPS — see DEPLOY.md.

# The 5chan bitsocial-cli daemon's local-only PKC RPC endpoint. The container
# uses host networking, so localhost here really is the VPS host. Do not put
# the daemon's remote auth key here; loopback connections do not need it.
PKC_RPC_URL=ws://localhost:9138

# Public URL of the web UI (used for sitemap / canonical links).
SITE_URL=https://5archive.org

# Browser origins allowed to call the API, comma-separated (the engine trims
# each entry). 5chan.app and the canonical 5chan.localhost dev server fetch
# this API straight from the browser, so both must stay listed here.
# Never leave this unset: the engine falls back to `*` (any origin).
ALLOWED_ORIGINS=https://5archive.org,https://5chan.app,https://5chan.localhost

# 5chan's own SFW verdicts by directory code (URL or path): how the engine
# learns a board is NSFW when its owner never set `features.safeForWork`.
DIRECTORY_DEFAULTS_SOURCE=https://raw.githubusercontent.com/bitsocialnet/lists/master/5chan-directories/5chan-directories-defaults.json

# Operator NSFW overrides — config/nsfw-overrides.json, bind-mounted like the
# blocklist (`[]` when empty) and watched the same way: no restart needed.
NSFW_OVERRIDES_SOURCE=/config/nsfw-overrides.json

# Re-crawl cadence (ms) and pagination depth per pass.
CRAWL_INTERVAL_MS=5000
CRAWL_CONCURRENCY=8
CRAWL_MAX_PAGES=20
