{
  "name": "@bitsocial/indexer-webui",
  "version": "0.0.1",
  "private": true,
  "description": "Web UI for the 5archive public archive and search engine",
  "license": "GPL-3.0-or-later",
  "author": "Bitsocial Forge",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node --experimental-strip-types ../scripts/check-typescript-sources.mts && tsc --noEmit && tsc --project tsconfig.scripts.json",
    "doctor": "react-doctor . -y --blocking none",
    "doctor:scan": "react-doctor scan",
    "doctor:check": "node --experimental-strip-types scripts/react-perf/doctor-check.mts",
    "perf:install": "node --experimental-strip-types scripts/react-perf/install-browser.mts",
    "perf:test": "node --experimental-strip-types scripts/react-perf/runner.mts selftest",
    "perf:check": "node --experimental-strip-types scripts/react-perf/runner.mts check",
    "perf:record": "node --experimental-strip-types scripts/react-perf/runner.mts record",
    "build:profile": "NEXT_PUBLIC_REACT_PERF=1 next build",
    "start:profile": "NEXT_PUBLIC_REACT_PERF=1 next start",
    "agent:verify": "npm run doctor:check && npm run typecheck && npm run test:scripts && npm run perf:check && npm run build",
    "test:scripts": "node --experimental-strip-types --test --test-concurrency=1 ../scripts/*.test.mts ../scripts/jev/tests/*.test.mts ../scripts/visual-qa/tests/*.test.mts scripts/react-perf/*.test.mts tests/*.test.mts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "agentation": "3.0.2",
    "react-doctor": "0.9.14",
    "typescript": "^6.0.3",
    "@playwright/cli": "0.1.19",
    "bippy": "0.7.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0-alpha-2026-08-31"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.8",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.2",
    "nanoid@3": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
