# Local development defaults, loaded by `next dev` only (`yarn start` from the
# repo root). Override any of these in webui/.env.local, which is gitignored.

# The local UI reads the public production API by default, so `yarn start` shows
# the real archive without running a crawler. Run the indexer locally (see
# docker-compose.yml) and set http://localhost:4000 to develop against your own
# index instead.
INDEXER_API=https://api.5archive.org

# Same branding as production (see DEPLOY.md).
SITE_NAME=5archive
SITE_BADGE=
SITE_URL=https://5archive.localhost
THEME=5chan
BRAND_TEXT=A Bitsocial Forge product
BRAND_URL=https://bitsocialforge.com
CONTACT_EMAIL=abuse@5archive.org
